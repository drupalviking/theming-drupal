+<?php
+
+namespace Drupal\viewsreference\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Defines a views reference setting attribute.
+ *
+ * Drupal 12 no longer discovers plugins by annotation alone: a plugin manager
+ * needs an attribute class, and keeps reading the annotation for BC.
+ *
+ * @see \Drupal\viewsreference\Plugin\ViewsReferenceSettingManager
+ * @see \Drupal\viewsreference\Annotation\ViewsReferenceSetting
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class ViewsReferenceSetting extends Plugin {
+
+  /**
+   * Constructs a ViewsReferenceSetting attribute.
+   *
+   * @param string $id
+   *   The plugin ID.
+   * @param \Drupal\Core\StringTranslation\TranslatableMarkup|null $label
+   *   The label of the plugin.
+   * @param mixed $default_value
+   *   The field default value.
+   * @param class-string|null $deriver
+   *   (optional) The deriver class.
+   */
+  public function __construct(
+    public readonly string $id,
+    public readonly ?TranslatableMarkup $label = NULL,
+    public readonly mixed $default_value = NULL,
+    public readonly ?string $deriver = NULL,
+  ) {}
+
+}
diff --git a/src/Hook/ViewsReferenceThemeHooks.php b/src/Hook/ViewsReferenceThemeHooks.php
new file mode 100644
index 0000000..94899a6
--- /dev/null
+++ b/src/Hook/ViewsReferenceThemeHooks.php
@@ -0,0 +1,23 @@
+<?php
+
+namespace Drupal\viewsreference\Hook;
+
+/**
+ * Preprocessing for the module's theme hooks.
+ *
+ * Registered with "initial preprocess" in viewsreference_theme(): Drupal 12
+ * no longer calls template_preprocess_HOOK() functions in .module files.
+ */
+class ViewsReferenceThemeHooks {
+
+  /**
+   * Prepares variables for viewsreference--view-title.html.twig.
+   */
+  public function preprocessViewTitle(array &$variables): void {
+    $variables['title'] = ['#markup' => $variables['variables']['#title']];
+    if (!empty($variables['variables']['#view'])) {
+      \Drupal::service('renderer')->addCacheableDependency($variables, $variables['variables']['#view']->storage);
+    }
+  }
+
+}
