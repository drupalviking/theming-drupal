{#
/**
 * @file
 * Any content in the Card view mode that has no template of its own, such
 * as an album or a news item in an area's list (Drupal CMS's views list
 * content as cards): the title as the one link, then the rest. No "Read more": the title already says where it goes.
 * For the variables, see core's node.html.twig.
 */
#}
{{ attach_library('mercury/teaser') }}
<article{{ attributes.addClass('teaser') }}>
  {{ title_prefix }}
  <h2{{ title_attributes.addClass('teaser__title') }}>
    <a href="{{ url }}">{{ label }}</a>
  </h2>
  {{ title_suffix }}
  <div class="teaser__content">
    {{ content|without('links') }}
  </div>
</article>
