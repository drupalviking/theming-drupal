{#
/**
 * @file
 * The photos of an album (the Photos field of the Gallery content type).
 *
 * The Album component draws the grid and the lightbox; this template only
 * puts each photo in a list item. For the variables, see core's
 * field.html.twig.
 */
#}
{% embed 'mercury:album' %}
  {% block photos %}
    {% for item in items %}
      <li>{{ item.content }}</li>
    {% endfor %}
  {% endblock %}
{% endembed %}
