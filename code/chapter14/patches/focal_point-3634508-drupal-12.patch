diff --git a/src/Hook/FocalPointHooks.php b/src/Hook/FocalPointHooks.php
new file mode 100644
index 0000000000000000000000000000000000000000..14074353ad694958418d199d32b37abba7b9c069
--- /dev/null
+++ b/src/Hook/FocalPointHooks.php	
@@ -0,0 +1,194 @@
+<?php
+
+namespace Drupal\focal_point\Hook;
+
+use Drupal\Component\Utility\NestedArray;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\EntityDisplayRepositoryInterface;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Entity\FieldableEntityInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\Routing\RouteMatchInterface;
+use Drupal\file\FileInterface;
+use Drupal\focal_point\FocalPointManagerInterface;
+
+/**
+ * Provides class-based hooks for the Focal Point module.
+ */
+class FocalPointHooks {
+
+  /**
+   * Constructs a new FocalPointHooks object.
+   *
+   * Automatically wired by Drupal 10.3+ / 11 using dependency injection.
+   */
+  public function __construct(
+    protected FocalPointManagerInterface $focalPointManager,
+    protected ConfigFactoryInterface $configFactory,
+    protected EntityDisplayRepositoryInterface $entityDisplayRepository,
+  ) {}
+
+  /**
+   * Implements hook_help().
+   */
+  #[Hook('help')]
+  public function help($route_name, RouteMatchInterface $route_match): ?string {
+    switch ($route_name) {
+      case 'help.page.focal_point':
+        $output = '<h3>' . t('About') . '</h3>';
+        $output .= '<p>' . t("Focal Point allows you to specify the portion of an image that is most important.</br>This information can be used when the image is cropped or cropped and scaled so that you don't, for example, end up with an image that cuts off the subject's head.") . '</p>';
+        return $output;
+    }
+    return NULL;
+  }
+
+  /**
+   * Implements hook_theme().
+   */
+  #[Hook('theme')]
+  public function theme(array $existing, string $type, string $theme, string $path): array {
+    return [
+      'focal_point_preview_page' => [
+        'variables' => [
+          'original_image' => NULL,
+          'derivative_images' => [],
+          'focal_point' => '',
+          'preview_image_note' => '',
+          'derivative_image_note' => '',
+        ],
+      ],
+    ];
+  }
+
+  /**
+   * Implements hook_entity_insert().
+   */
+  #[Hook('entity_insert')]
+  public function entityInsert(EntityInterface $entity): void {
+    $this->entityUpdate($entity);
+  }
+
+  /**
+   * Implements hook_entity_update().
+   */
+  #[Hook('entity_update')]
+  public function entityUpdate(EntityInterface $entity): void {
+    // Only worry about entities that are fieldable.
+    if ($entity instanceof FieldableEntityInterface) {
+      $config = $this->configFactory->get('focal_point.settings');
+      $crop_type = $config->get('crop_type');
+      // Loop all the fields and save focal point values for images.
+      foreach ($entity->getFieldDefinitions() as $field) {
+        if ($field->getType() == 'image' && $entity->hasField($field->getName())) {
+          // Loop through all values for this field.
+          // Its cardinality might be > 1.
+          foreach ($entity->{$field->getName()} as $item) {
+            if (!$item->entity instanceof FileInterface) {
+              continue;
+            }
+            $crop = $this->focalPointManager->getCropEntity($item->entity, $crop_type);
+
+            $focal_point = NULL;
+            // Use the default focal point on new crop entities.
+            if ($crop->isNew()) {
+              $focal_point = $config->get('default_value');
+            }
+            // Use the focal point set over the UI.
+            if (!empty($item->focal_point)) {
+              $focal_point = $item->focal_point;
+              // Keep the original focal_point value to be able to use it
+              // during hooks.
+              if (!$crop->get('x')->isEmpty() && !$crop->get('y')->isEmpty()) {
+                $x = $crop->get('x')->value;
+                $y = $crop->get('y')->value;
+                $width = $item->width ?? 0;
+                $height = $item->height ?? 0;
+                $focal_point_original = $this->focalPointManager->absoluteToRelative($x, $y, $width, $height);
+                $entity->{$field->getName()}->focal_point_original = implode(',', $focal_point_original);
+              }
+            }
+            if ($focal_point && $item->width && $item->height) {
+              [$x, $y] = explode(',', $focal_point);
+              $this->focalPointManager->saveCropEntity($x, $y, $item->width, $item->height, $crop);
+            }
+          }
+        }
+      }
+    }
+  }
+
+  /**
+   * Implements hook_imce_supported_widgets_alter().
+   */
+  #[Hook('imce_supported_widgets_alter')]
+  public function imceSupportedWidgetsAlter(array &$widgets): void {
+    $widgets[] = 'image_focal_point';
+  }
+
+  /**
+   * Implements hook_form_FORM_ID_alter() for media_library_add_form_dropzonejs.
+   */
+  #[Hook('form_media_library_add_form_dropzonejs_alter')]
+  public function formMediaLibraryAddFormDropzonejsAlter(array &$form, FormStateInterface $form_state): void {
+    // Call our form-alter for the upload form-id to make sure focal_point is added.
+    $this->formMediaLibraryAddFormUploadAlter($form, $form_state);
+  }
+
+  /**
+   * Implements hook_form_FORM_ID_alter() for media_library_add_form_upload.
+   */
+  #[Hook('form_media_library_add_form_upload_alter')]
+  public function formMediaLibraryAddFormUploadAlter(array &$form, FormStateInterface $form_state): void {
+    // Get any media items that are in the process of being added.
+    $media = $form_state->get('media') ?: [];
+
+    /** @var \Drupal\media\MediaInterface $item */
+    foreach ($media as $delta => $item) {
+      if (!isset($form['media'][$delta]['fields'])) {
+        continue;
+      }
+
+      $element = &$form['media'][$delta]['fields'];
+      // As a kindness to alter hooks like this one, Media Library includes the
+      // name of the source field in the form structure.
+      // @see \Drupal\media_library\Form\AddFormBase::buildEntityFormElement()
+      $source_field = $element['#source_field_name'] ?? NULL;
+
+      if ($source_field) {
+        // If the source field is configured to use Focal Point, add a #process
+        // callback which replaces the static preview thumbnail with the
+        // Focal Point widget.
+        $component = $this->entityDisplayRepository
+          ->getFormDisplay('media', $item->bundle(), 'media_library')
+          ->getComponent($source_field);
+
+        if ($component && $component['type'] === 'image_focal_point' && isset($element[$source_field])) {
+          // Points directly to the class method instance instead of a procedural function.
+          $element[$source_field]['widget'][0]['#process'][] = [
+            $this,
+            'replaceMediaLibraryPreview'
+          ];
+        }
+      }
+    }
+  }
+
+  /**
+   * Process callback for the preview image of a new item in the media library.
+   */
+  public function replaceMediaLibraryPreview(array $element, FormStateInterface $form_state, array &$form): array {
+    if (!empty($element['preview'])) {
+      $preview_access = $element['preview']['#access'];
+      $element['preview']['#access'] = TRUE;
+
+      $target = $element['#array_parents'];
+      array_splice($target, -4, count($target), ['preview', 'thumbnail']);
+      NestedArray::setValue($form, $target, $element['preview']);
+
+      $element['preview']['#access'] = $preview_access;
+    }
+    return $element;
+  }
+
+}
