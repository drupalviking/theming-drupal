--- /dev/null
+++ b/src/Hook/CropRequirementsHooks.php
@@ -0,0 +1,21 @@
+<?php
+
+namespace Drupal\crop\Hook;
+
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\crop\Install\Requirements\CropRequirements;
+
+/**
+ * Runtime requirements for Crop API, on the status report.
+ */
+class CropRequirementsHooks {
+
+  /**
+   * Implements hook_runtime_requirements().
+   */
+  #[Hook('runtime_requirements')]
+  public function runtimeRequirements(): array {
+    return CropRequirements::getRequirements();
+  }
+
+}
diff --git a/src/Install/Requirements/CropRequirements.php b/src/Install/Requirements/CropRequirements.php
new file mode 100644
index 0000000..06f7a1e
--- /dev/null
+++ b/src/Install/Requirements/CropRequirements.php
@@ -0,0 +1,44 @@
+<?php
+
+namespace Drupal\crop\Install\Requirements;
+
+use Drupal\Core\Extension\InstallRequirementsInterface;
+use Drupal\Core\Extension\Requirement\RequirementSeverity;
+
+/**
+ * Install-time requirements for Crop API.
+ *
+ * Was crop_requirements() in crop.install. On Drupal 12, a procedural
+ * hook_requirements() in an .install file breaks drupal_check_module() for
+ * every module ("Class crop_requirements does not exist").
+ */
+class CropRequirements implements InstallRequirementsInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function getRequirements(): array {
+    $requirements = [];
+
+    // This branch of Crop API shouldn't be used with media_entity 1.x enabled.
+    $incompatible = FALSE;
+    if (\Drupal::hasService('module_handler') && \Drupal::moduleHandler()->moduleExists('media_entity')) {
+      $info = \Drupal::service('extension.list.module')->getExtensionInfo('media_entity');
+      if (version_compare($info['version'], '8.x-2') < 0) {
+        $incompatible = TRUE;
+      }
+    }
+
+    if ($incompatible) {
+      $requirements['crop_media'] = [
+        'title' => t('Crop API'),
+        'value' => t('This branch of Crop API is not compatible with the version of Media Entity installed.'),
+        'description' => t('This branch of Crop API is not compatible with the version of Media Entity installed.'),
+        'severity' => RequirementSeverity::Error,
+      ];
+    }
+
+    return $requirements;
+  }
+
+}
